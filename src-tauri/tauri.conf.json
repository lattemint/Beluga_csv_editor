{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beluga CSV Editor",
  "version": "0.1.1",
  "identifier": "com.beluga.csv-editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beluga CSV Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../LICENSE.md"],
    "license": "MIT",
    "licenseFile": "../LICENSE.rtf",
    "publisher": "Neko Soul",
    "copyright": "Copyright (c) 2026 Beluga CSV Editor contributors",
    "shortDescription": "字节级保真的 CSV 编辑器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
